{
  "name": "@cvb/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/cli/migrate.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@cvb/shared": "0.1.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "5.81.5",
    "pdfmake": "0.2.23",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pdfmake": "0.2.13",
    "jest": "29.7.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
